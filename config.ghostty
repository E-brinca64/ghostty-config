
# --------------------------------------------------
# 01. TYPOGRAPHY
# --------------------------------------------------

font-family = Hack
font-size = 10.5

font-feature = +calt
font-feature = +zero
font-feature = +tnum


# --------------------------------------------------
# 02. THEME & COLORS
# --------------------------------------------------

theme = cyberpunk-icy

background = #000000
background-opacity = 0.95


# --------------------------------------------------
# 03. WINDOW & TITLEBAR
# --------------------------------------------------

window-decoration = server
window-theme = ghostty

window-titlebar-background = #000000
window-titlebar-foreground = #00ff00

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true


# --------------------------------------------------
# 04. CURSOR & INPUT
# --------------------------------------------------

cursor-style = bar
cursor-style-blink = true
cursor-color = #00ff00

mouse-hide-while-typing = true


# --------------------------------------------------
# 05. WINDOW BEHAVIOR
# --------------------------------------------------

confirm-close-surface = false
scrollbar = never

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

working-directory = home


# --------------------------------------------------
# 06. CLIPBOARD
# --------------------------------------------------

copy-on-select = clipboard

clipboard-read = ask
clipboard-write = allow


# --------------------------------------------------
# 07. NOTIFICATIONS
# --------------------------------------------------

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 3s


# --------------------------------------------------
# 08. SHELL INTEGRATION
# --------------------------------------------------

shell-integration = detect

shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo


# --------------------------------------------------
# 09. KEYBOARD
# --------------------------------------------------

keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab
keybind = ctrl+shift+t=new_window

keybind = alt+p=text:|


# --------------------------------------------------
# 10. SPLITS
# --------------------------------------------------

keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+e=new_split:right


